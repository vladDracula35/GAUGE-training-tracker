<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GAUGE.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="GAUGE.Views.HomeView">

    <Panel Background="Transparent" Focusable="True">
        <!-- ДІАЛОГ АВТОЗБЕРЕЖЕННЯ -->
        <Border ZIndex="2000" Background="#E6000000" IsVisible="{Binding IsAutosaveDialogVisible}">
            <Border Background="#2A2A2A" CornerRadius="40" Padding="30" HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderBrush="#404040" BorderThickness="1" Margin="30">
                <StackPanel Spacing="25">
                    <TextBlock Text="ЗНАЙДЕНО НЕЗАКІНЧЕНЕ ТРЕНУВАННЯ" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Бажаєш повернутись до виконання вправ і продовжити прогрес?" FontSize="14" Foreground="#888888" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 20, *">
                        <Button Grid.Column="0" Height="60" CornerRadius="20" Background="#800020" Command="{Binding CancelRestoreWorkoutCommand}" ClickMode="Press" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="НІ" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2" Height="60" CornerRadius="20" Background="#2B4E2B" Command="{Binding ConfirmRestoreWorkoutCommand}" ClickMode="Press" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="ТАК" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ЕКРАН ДЕТАЛЕЙ ЗАВЕРШЕНОГО ТРЕНУВАННЯ -->
        <Border ZIndex="3000" Background="#F01E1E1E" IsVisible="{Binding IsWorkoutDetailsVisible}">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20,40,20,30">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                    <TextBlock Text="{Binding DetailsTitle}" FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseWorkoutDetailsCommand}"
                            Background="Transparent" Foreground="#888888" FontSize="22" FontWeight="Bold"
                            Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding DetailsSets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A2A" CornerRadius="15" Padding="15" Margin="0,0,0,10" BorderBrush="#3A3A3A" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ПІДХІД" Foreground="#888888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E3DAD1" FontWeight="Medium"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Reps, StringFormat={}{0} повт.}" Foreground="#8C2424" Margin="10,0" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RestSeconds, StringFormat={}{0}s}" Foreground="#2B4E2B" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Command="{Binding ExportCurrentDetailsToMarkdownCommand}"
                        Height="55" CornerRadius="20" Background="#2B4E2B" Margin="0,15,0,0" Padding="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="Зберегти в Obsidian (.md)" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ГОЛОВНИЙ ЕКРАН -->
        <ScrollViewer>
            <StackPanel Spacing="25" Margin="25,40,25,35">
                
                <!-- Заголовок GAUGE -->
                <Border Height="80" CornerRadius="25" BorderBrush="#404040" BorderThickness="2" Background="#2A2A2A">
                    <TextBlock Text="GAUGE" FontSize="34" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" LetterSpacing="8"/>
                </Border>

                <!-- ПОРАДА СЕНСЕЯ -->
                <Border Background="#2A2A2A" CornerRadius="20" Padding="18" BorderBrush="#404040" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ПОРАДА СЕНСЕЯ" Foreground="#800020" FontSize="12" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AiQuote}" Foreground="#e3dad1" FontSize="14" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- КАЛЕНДАР АКТИВНОСТІ (STREAK HEATMAP) -->
             <!-- КАЛЕНДАР АКТИВНОСТІ (STREAK HEATMAP) -->
<Border Background="#222222" CornerRadius="22" Padding="15" BorderBrush="#333333" BorderThickness="1">
    <StackPanel Spacing="10">
        
        <!-- Шапка календаря: Стрілка вліво, Назва місяця, Стрілка вправо -->
        <Grid ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0" Content="◀" Command="{Binding PreviousMonthCommand}"
                    Background="Transparent" Foreground="#888888" FontSize="14" FontWeight="Bold"
                    Padding="10,5" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="{Binding CurrentMonthTitle}" Foreground="#E3DAD1" 
                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" LetterSpacing="1"/>

            <Button Grid.Column="2" Content="▶" Command="{Binding NextMonthCommand}"
                    Background="Transparent" Foreground="#888888" FontSize="14" FontWeight="Bold"
                    Padding="10,5" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Заголовки днів тижня -->
        <Grid ColumnDefinitions="*, *, *, *, *, *, *">
            <TextBlock Grid.Column="0" Text="ПН" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="ВТ" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="СР" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="ЧТ" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="ПТ" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="СБ" FontSize="10" FontWeight="Bold" Foreground="#800020" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="НД" FontSize="10" FontWeight="Bold" Foreground="#800020" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Сітка місяця -->
        <ItemsControl ItemsSource="{Binding CurrentMonthDays}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
    <DataTemplate>
        <Border Height="36" Margin="1" CornerRadius="10" 
                Background="{Binding CellBackground}"
                BorderBrush="{Binding CellBorder}"
                BorderThickness="1.5">
            <TextBlock Text="{Binding DayNumber}" 
                       FontSize="13" 
                       FontWeight="Bold"
                       Foreground="{Binding TextColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Border>

                <!-- ОСТАННІ ТРЕНУВАННЯ -->
                <TextBlock Text="Останні тренування" Foreground="#888888" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,-15"/>

                <Border Background="#222222" CornerRadius="25" Padding="15" BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer MaxHeight="220" AllowAutoHide="False">
                        <ItemsControl ItemsSource="{Binding PastWorkouts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="#2A2A2A" CornerRadius="15" Padding="15" Margin="0,0,10,10" 
                                            BorderBrush="#404040" BorderThickness="1" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenWorkoutDetailsCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" Foreground="#e3dad1" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="#888888" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- КНОПКА СТАРТУ ТРЕНУВАННЯ -->
                <Button Command="{Binding StartNewWorkoutCommand}" Width="150" Height="150" CornerRadius="75" 
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Margin="0,5" ClickMode="Press">
                    <Panel>
                        <Image Source="avares://GAUGE/Assets/cross_bg.png" Stretch="Uniform" /> 
                        <Image Source="avares://GAUGE/Assets/main_cross.png" Stretch="Uniform" /> 
                    </Panel>
                </Button>

                <!-- Кнопка експорту -->
                <Button Command="{Binding OpenExportMenuCommand}" Width="170" Height="46" CornerRadius="23" 
                        Background="#800020" BorderThickness="0" HorizontalAlignment="Center" Margin="0,5" ClickMode="Press"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="Export Workouts" FontSize="14" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ДІАЛОГ ВИБОРУ ТРЕНУВАНЬ ДЛЯ ЕКСПОРТУ -->
        <Border Background="#2A2A2A" CornerRadius="25" Padding="30" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsVisible="{Binding IsExportDialogVisible}" Margin="0,0,0,10">
            <StackPanel Spacing="25">
                <TextBlock Text="Select Workouts to Export" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <ListBox ItemsSource="{Binding AvailableWorkouts}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                    <Button Command="{Binding CancelExportCommand}" Width="110" Height="44" CornerRadius="22" 
                            Background="#800020" BorderThickness="0" ClickMode="Press"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Text="Cancel" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding ConfirmExportCommand}" Width="110" Height="44" CornerRadius="22" 
                            Background="#2B4E2B" BorderThickness="0" ClickMode="Press"
                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Text="Export" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

    </Panel>
</UserControl>