<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppCompat.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Повністю вирубаємо ActionBar та заголовок вікна -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        
        <!-- Робимо фон чорним, щоб системні бари зливалися зі стилем -->
        <item name="android:windowBackground">#222222</item>
        <item name="android:statusBarColor">#222222</item>
        <item name="android:navigationBarColor">#222222</item>
    </style>
</resources>